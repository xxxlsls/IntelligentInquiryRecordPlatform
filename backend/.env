# ============================================================
# 智能问询笔录平台 · 后端环境变量（本地 Ollama 私有化接入）
# ------------------------------------------------------------
# 对话模型 qwen3:8b + 向量模型 bge-m3 均通过本地 Ollama（11434）提供，
# 共用同一 OpenAI 兼容端点，故 LLM_BASE_URL 指向 http://127.0.0.1:11434/v1。
# ============================================================

# ---------- 应用基础 ----------
# APP_NAME=智能问询笔录平台
DEBUG=True
# DATABASE_URL=sqlite:///./inquiry_platform.db

# ---------- 安全 ----------
# JWT_SECRET_KEY=change-this-secret-key-in-production-2026

# ============================================================
# 大模型私有化接入（Ollama）
# ============================================================

# 总开关：True 时走 LLM 增强链路；不可用/超时会自动降级到规则算法
LLM_ENABLED=True

# OpenAI 兼容服务基础地址（注意末尾带 /v1）
LLM_BASE_URL=http://127.0.0.1:11434/v1
# 本地 Ollama 无需鉴权，保留占位 key
LLM_API_KEY=not-needed

# 对话模型与向量模型名（需与 ollama list 中一致）
LLM_CHAT_MODEL=qwen3:8b
LLM_EMBEDDING_MODEL=bge-m3

# 请求超时（秒）、失败重试次数、生成温度
# LLM_TIMEOUT_SECONDS 作用于向量（embeddings）等轻量调用；语义匹配为同步交互，短超时尽快降级
LLM_TIMEOUT_SECONDS=30.0
# LLM_CHAT_TIMEOUT_SECONDS 作用于对话生成类任务（研判/五流抽取/笔录解析）：
# 本地大模型推理慢（研判约 20 秒，冷启动/长文本更久），前端研判已后台非阻塞，给足超时避免降级
LLM_CHAT_TIMEOUT_SECONDS=120.0
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1

# ---------- 分能力开关 ----------
LLM_ENABLE_SEMANTIC_MATCH=True    # 能力一：语义匹配推荐（依赖 bge-m3）
LLM_ENABLE_ANALYSIS=True          # 能力二：侦查研判建议生成
LLM_ENABLE_EXTRACTION=True        # 能力三：五流要素抽取
LLM_ENABLE_IMPORT_PARSE=True      # 能力四：历史笔录解析导入
