# ============================================================
# 智能问询笔录平台 · 后端环境变量示例
# ------------------------------------------------------------
# 复制为 backend/.env 后按需修改；未提供的项使用 config.py 中的默认值。
# 说明：默认 LLM_ENABLED=False，即"零大模型"运行，行为与规则算法基线完全一致；
#       仅当内网已部署 OpenAI 兼容推理服务并显式开启时，才走 LLM 增强链路。
# ============================================================

# ---------- 应用基础 ----------
# APP_NAME=智能问询笔录平台
# DEBUG=True
# DATABASE_URL=sqlite:///./inquiry_platform.db

# ---------- 安全 ----------
# JWT_SECRET_KEY=change-this-secret-key-in-production-2026

# ============================================================
# 大模型私有化接入（12.3 Q-7）
# ------------------------------------------------------------
# 走 OpenAI 兼容 HTTP 接口（/v1/chat/completions、/v1/embeddings），
# 适配 Ollama / vLLM / Xinference，仅用 httpx 直连，不引入厂商 SDK。
# 合规：案情数据仅发送至内网模型端点，禁止外发公网。
# ============================================================

# 总开关：False（默认）时全部能力走规则算法，零行为变化
LLM_ENABLED=False

# OpenAI 兼容服务基础地址（注意末尾带 /v1）
LLM_BASE_URL=http://127.0.0.1:11434/v1
# 内网服务通常无需鉴权；若网关强制校验，请填写实际 key
LLM_API_KEY=not-needed

# 对话模型与向量模型名（需与推理服务实际加载的模型一致）
# 对话模型：qwen3:8b（Ollama）；向量模型：bge-m3（qwen3 无内置 embedding，需单独部署向量模型）
LLM_CHAT_MODEL=qwen3:8b
LLM_EMBEDDING_MODEL=bge-m3

# 请求超时（秒）、失败重试次数、生成温度
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1

# ---------- 分能力开关（可单独降级任一能力） ----------
LLM_ENABLE_SEMANTIC_MATCH=True    # 能力一：语义匹配推荐（F_sem 向量化）
LLM_ENABLE_ANALYSIS=True          # 能力二：侦查研判建议生成
LLM_ENABLE_EXTRACTION=True        # 能力三：五流要素抽取（正则 + LLM 融合）
LLM_ENABLE_IMPORT_PARSE=True      # 能力四：历史笔录解析导入

# ============================================================
# 部署示例
# ------------------------------------------------------------
# 【Ollama】（推荐用于内网快速拉起）
#   1) 安装 Ollama 后拉取模型：
#        ollama pull qwen3:8b
#        ollama pull bge-m3
#   2) Ollama 默认在 http://127.0.0.1:11434 提供 OpenAI 兼容接口（/v1），
#      故 LLM_BASE_URL 填 http://127.0.0.1:11434/v1 即可。
#   3) 设置 LLM_ENABLED=True 重启后端；调用 POST /api/v1/ai/llm/reindex-templates
#      预计算模板向量，随后验证推荐/研判/抽取/导入四条链路。
#   注：qwen3 默认开启思考（thinking）模式；本平台请求已带 response_format=json_object，
#       Ollama 在结构化输出时会自动关闭思考。若仍出现 JSON 解析失败（会自动降级到规则算法），
#       可在提示词末尾追加 /no_think 或改用非思考模型。
#
# 【vLLM】
#   python -m vllm.entrypoints.openai.api_server \
#     --model /models/Qwen3-8B --served-model-name qwen3:8b \
#     --port 8000
#   另需单独部署 embedding 服务（如 bge-m3），并分别配置对话/向量模型名与地址。
#   LLM_BASE_URL=http://<内网IP>:8000/v1
#
# 【Xinference】
#   在 Web UI 启动 chat 与 embedding 两类模型，LLM_BASE_URL 指向其 OpenAI 兼容端点。
# ============================================================
